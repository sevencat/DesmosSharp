<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesmosSharp.App.ViewModels"
        xmlns:controls="using:DesmosSharp.App.Controls"
        xmlns:i18n="using:DesmosSharp.App.Localization"
        x:Class="DesmosSharp.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{i18n:Localize UntitledGraph}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#F5F6F8">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- 滑块范围编辑用的紧凑输入框 -->
    <Style Selector="Border.paramInput">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7DBE2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="1,0" />
    </Style>
    <Style Selector="Border.paramInput TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="56,*,28">

    <!-- 顶部栏 -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E4EA" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Background="#3F51B5" />
          <TextBlock Text="DesmosSharp" FontSize="18" FontWeight="SemiBold"
                     Foreground="#1F2329" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="↶" ToolTip.Tip="{i18n:Localize Undo}" Padding="10,4" FontSize="16"
                  Command="{Binding UndoCommand}" />
          <Button Content="↷" ToolTip.Tip="{i18n:Localize Redo}" Padding="10,4" FontSize="16"
                  Command="{Binding RedoCommand}" />
          <ComboBox Width="120" Margin="8,0,8,0" VerticalAlignment="Center"
                    ItemsSource="{Binding Localization.Languages}"
                    SelectedItem="{Binding Localization.SelectedLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="i18n:LanguageOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{i18n:Localize Open}" Padding="12,6" IsEnabled="False" />
          <Button Content="{i18n:Localize Save}" Padding="12,6" IsEnabled="False" />
          <Button Content="{i18n:Localize Settings}" Padding="12,6" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体：表达式列表 + 图形画板 -->
    <Grid Grid.Row="1" ColumnDefinitions="380,*">

      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E1E4EA" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="48,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="16,0">
            <TextBlock x:Name="ExpressionsHeader"
                       Text="{i18n:Localize Expressions}"
                       FontWeight="SemiBold" Foreground="#1F2329" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{i18n:Localize ClearAll}" Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding ClearAllCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{i18n:Localize AddExpression}" Padding="10,4"
                    Command="{Binding AddExpressionCommand}" VerticalAlignment="Center" />
          </Grid>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ExpressionsList" ItemsSource="{Binding Expressions}" Margin="8,0,8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpressionItemViewModel">
                  <Grid ColumnDefinitions="20,Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                        Margin="0,2">
                    <TextBlock Text="{Binding Number}" Foreground="#8A8F99" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Width="14" Height="14" Padding="0" CornerRadius="7"
                            Margin="0,0,8,0" Background="{Binding Color}" BorderThickness="0"
                            VerticalAlignment="Center"
                            Command="{Binding CycleColorCommand}"
                            ToolTip.Tip="{i18n:Localize ChangeColor}" />

                    <TextBox Grid.Column="2" Text="{Binding Latex}" AcceptsReturn="False"
                             PlaceholderText="{i18n:Localize ExpressionPlaceholder}"
                             VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                             KeyDown="OnExpressionKeyDown" />

                    <CheckBox Grid.Column="3" IsChecked="{Binding IsVisible}" Padding="0" MinWidth="0"
                              Margin="4,0" VerticalAlignment="Center"
                              ToolTip.Tip="{i18n:Localize ToggleVisibility}" />

                    <Button Grid.Column="4" Content="⧉" Width="20" Height="20" Padding="0" FontSize="13"
                            Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                            VerticalAlignment="Center"
                            Command="{Binding DuplicateCommand}"
                            ToolTip.Tip="{i18n:Localize Duplicate}" />
                    <Button Grid.Column="5" Content="↑" Width="20" Height="20" Padding="0" FontSize="13"
                            Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                            VerticalAlignment="Center"
                            Command="{Binding MoveUpCommand}"
                            ToolTip.Tip="{i18n:Localize MoveUp}" />
                    <Button Grid.Column="6" Content="↓" Width="20" Height="20" Padding="0" FontSize="13"
                            Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                            VerticalAlignment="Center"
                            Command="{Binding MoveDownCommand}"
                            ToolTip.Tip="{i18n:Localize MoveDown}" />
                    <Button Grid.Column="7" Content="×" Width="20" Height="20" Padding="0" FontSize="13"
                            Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                            VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}"
                            ToolTip.Tip="{i18n:Localize Delete}" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="6"
                               Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               Foreground="#D32F2F" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7"
                                  ItemsSource="{Binding Parameters}" Margin="0,0,4,6">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParameterViewModel">
                          <Grid RowDefinitions="Auto,Auto" Margin="0,2,0,4">
                            <Grid ColumnDefinitions="16,*,50,18,22">
                              <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="12"
                                         Foreground="#5B6270" VerticalAlignment="Center" />

                              <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                      Value="{Binding Value}" Margin="6,0" VerticalAlignment="Center" />

                              <TextBox Grid.Column="2" Text="{Binding Value}" FontSize="12"
                                       Height="24" MinHeight="0" Padding="4,0"
                                       VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                       VerticalAlignment="Center" />

                              <Button Grid.Column="3" Content="⋯" Width="18" Height="24" Padding="0" FontSize="11"
                                      Background="Transparent" BorderThickness="0" Foreground="#8A8F99"
                                      VerticalAlignment="Center"
                                      Command="{Binding ToggleSettingsCommand}"
                                      ToolTip.Tip="{i18n:Localize ParameterSettings}" />

                              <Panel Grid.Column="4" VerticalAlignment="Center">
                                <Button Content="▶" Width="22" Height="22" Padding="0" FontSize="10"
                                        Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                                        IsVisible="{Binding !IsAnimating}"
                                        Command="{Binding ToggleAnimationCommand}"
                                        ToolTip.Tip="{i18n:Localize Play}" />
                                <Button Content="❚❚" Width="22" Height="22" Padding="0" FontSize="8"
                                        Background="Transparent" BorderThickness="0" Foreground="#5B6270"
                                        IsVisible="{Binding IsAnimating}"
                                        Command="{Binding ToggleAnimationCommand}"
                                        ToolTip.Tip="{i18n:Localize Pause}" />
                              </Panel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="22,4,6,0"
                                  IsVisible="{Binding IsEditingSettings}">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{i18n:Localize Minimum}" FontSize="10"
                                           Foreground="#8A8F99" VerticalAlignment="Center" />
                                <Border Classes="paramInput">
                                  <TextBox Text="{Binding Minimum}" Width="40" FontSize="10"
                                           Height="20" MinHeight="0" Padding="3,0" VerticalContentAlignment="Center" />
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="{i18n:Localize Maximum}" FontSize="10"
                                           Foreground="#8A8F99" VerticalAlignment="Center" />
                                <Border Classes="paramInput">
                                  <TextBox Text="{Binding Maximum}" Width="40" FontSize="10"
                                           Height="20" MinHeight="0" Padding="3,0" VerticalContentAlignment="Center" />
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="{i18n:Localize Step}" FontSize="10"
                                           Foreground="#8A8F99" VerticalAlignment="Center" />
                                <Border Classes="paramInput">
                                  <TextBox Text="{Binding Step}" Width="40" FontSize="10"
                                           Height="20" MinHeight="0" Padding="3,0" VerticalContentAlignment="Center" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <controls:GraphView Grid.Column="1" Functions="{Binding Functions}" />

    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E4EA" BorderThickness="0,1,0,0" Padding="12,0">
      <TextBlock Text="{i18n:Localize StatusReady}" FontSize="12" Foreground="#8A8F99" VerticalAlignment="Center" />
    </Border>

  </Grid>
</Window>
